<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0-beta</Version>
    <PackageVersion>0.2.0-beta</PackageVersion>
    <Title>AudioSeparator.Onnx.Demucs</Title>
    <Description>Demucs/htdemucs ONNX backend for AudioSeparator — separate audio into drums, bass, vocals, and other stems.</Description>
    <PackageTags>audio;stem-separation;onnx;demucs;htdemucs;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/gabrieloliveirabrito/AudioSeparator/tree/main/AudioSeparator.Onnx.Demucs</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.28.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioSeparator.Onnx\AudioSeparator.Onnx.csproj" />
  </ItemGroup>

</Project>
