<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0-beta</Version>
    <PackageVersion>0.2.0-beta</PackageVersion>
    <Title>AudioSeparator.Onnx.Mdx</Title>
    <Description>MDX-Net ONNX backend for AudioSeparator — UVR-style instrumental/vocals separation with host STFT.</Description>
    <PackageTags>audio;stem-separation;onnx;mdx;uvr;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/gabrieloliveirabrito/AudioSeparator/tree/main/AudioSeparator.Onnx.Mdx</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.28.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioSeparator.Onnx\AudioSeparator.Onnx.csproj" />
  </ItemGroup>

</Project>
